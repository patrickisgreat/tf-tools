# Local .terraform directories
**/.terraform/*
.terraform.tfstate.lock.info

# State files (never commit state)
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# tfvars may contain secrets — keep the *.example templates only
*.tfvars
*.tfvars.json
!*.tfvars.example

# Saved plans
*.tfplan
*.tfplan.*

# CLI config / credentials
.terraformrc
terraform.rc

# Override files (local-only convenience overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Editor / OS noise
.DS_Store
.idea/
.vscode/

# Lock files under modules/ are a side effect of `make validate` / `make test`
# running `terraform init` in every module and example. Reusable modules must not
# pin providers (see docs/CONVENTIONS.md), so these are local noise.
#
# NOTE: .terraform.lock.hcl IS committed for root configs under environments/ —
# do not ignore it there.
modules/**/.terraform.lock.hcl
